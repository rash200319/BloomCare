# ─────────────────────────────────────────────────────────────────────────────
# BloomCare Backend – Environment Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
BLOOMCARE_OPENAI_MODEL=gpt-4o
BLOOMCARE_MOCK_LLM=true

# ── Server ────────────────────────────────────────────────────────────────────
BLOOMCARE_HOST=0.0.0.0
BLOOMCARE_PORT=8001
BLOOMCARE_RELOAD=true
BLOOMCARE_LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_SERVER=localhost
POSTGRES_USER=bloomcare_user
POSTGRES_PASSWORD=bloomcare_pass
POSTGRES_DB=bloomcare_db
POSTGRES_PORT=5432
# POSTGRES_HOST_PORT=5433

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED on Railway / any shared host: set a long random SECRET_KEY.
SECRET_KEY=bloomcare-local-demo-only-change-me
ALGORITHM=HS256
# Default in code is 480 (8 hours). Was 7 days.
ACCESS_TOKEN_EXPIRE_MINUTES=480

BLOOMCARE_ENV=local
# Set true only AFTER SECRET_KEY is set on the host.
BLOOMCARE_ENFORCE_SECRETS=false
# Set true in production to hide /docs and /openapi.json
BLOOMCARE_DISABLE_API_DOCS=false
# Local demos only — never enable on Railway
BLOOMCARE_EXPOSE_DEMO_OTP=false

# ALLOWED_ORIGINS=https://bloomcare.rashmip.me
