# ─────────────────────────────────────────────
#  BloomCare Backend — Environment Variables
#  Copy this file to .env and edit as needed
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
POSTGRES_SERVER=127.0.0.1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=2003
POSTGRES_DB=bloomcare
POSTGRES_PORT=5432

# ── Security ──────────────────────────────────
# IMPORTANT: Change this to a long random string in production!
SECRET_KEY=bloomcare-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI / ML Mode ─────────────────────────────
# Set to false to use real .pkl models
BLOOMCARE_MOCK_LLM=true

# ── Server ────────────────────────────────────
DEBUG=false
# ─────────────────────────────────────────────────────────────────────────────
# BloomCare Backend – Environment Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Your OpenAI API key.  Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Model to use for clinical explanations (default: gpt-4o).
# Options: gpt-4o | gpt-4o-mini | gpt-4-turbo
BLOOMCARE_OPENAI_MODEL=gpt-4o

# Set to "true" to use the built-in offline mock LLM (no API key required).
# Set to "false" in production to use the live OpenAI API.
BLOOMCARE_MOCK_LLM=true

# ── Server ────────────────────────────────────────────────────────────────────
BLOOMCARE_HOST=0.0.0.0
BLOOMCARE_PORT=8001
BLOOMCARE_RELOAD=true
BLOOMCARE_LOG_LEVEL=info

# ── FHIR / EHR Integration (future) ──────────────────────────────────────────
# FHIR_SERVER_URL=https://your-fhir-server.lk/fhir/r4
# FHIR_CLIENT_ID=bloomcare-client
# FHIR_CLIENT_SECRET=...

# ── Database (future) ─────────────────────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bloomcare_db

# ── Security ──────────────────────────────────────────────────────────────────
# SECRET_KEY=change-me-in-production-min-32-chars
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60
