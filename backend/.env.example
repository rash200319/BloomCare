# ─────────────────────────────────────────────────────────────────────────────
# BloomCare Backend – Environment Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Your OpenAI API key.  Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Model to use for clinical explanations (default: gpt-4o).
# Options: gpt-4o | gpt-4o-mini | gpt-4-turbo
BLOOMCARE_OPENAI_MODEL=gpt-4o

# Set to "true" to use the built-in offline mock LLM (no API key required).
# Set to "false" in production to use the live OpenAI API.
BLOOMCARE_MOCK_LLM=true

# ── Server ────────────────────────────────────────────────────────────────────
BLOOMCARE_HOST=0.0.0.0
BLOOMCARE_PORT=8001
BLOOMCARE_RELOAD=true
BLOOMCARE_LOG_LEVEL=info

# ── FHIR / EHR Integration (future) ──────────────────────────────────────────
# FHIR_SERVER_URL=https://your-fhir-server.lk/fhir/r4
# FHIR_CLIENT_ID=bloomcare-client
# FHIR_CLIENT_SECRET=...

# ── Database ──────────────────────────────────────────────────────────────────
# Read directly by backend/core/config.py — matches backend/docker-compose.yml.
POSTGRES_SERVER=localhost
POSTGRES_USER=bloomcare_user
POSTGRES_PASSWORD=bloomcare_pass
POSTGRES_DB=bloomcare_db
POSTGRES_PORT=5432

# Docker's published host port for the db container (docker-compose.yml reads
# this; only needed if 5432 is already taken on your machine). Keep in sync
# with POSTGRES_PORT above.
# POSTGRES_HOST_PORT=5433

# ── Security ──────────────────────────────────────────────────────────────────
# Read directly by backend/core/config.py. Change SECRET_KEY before any
# shared or production deployment.
SECRET_KEY=change-me-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
