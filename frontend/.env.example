# BloomCare Frontend Environment Variables
# Copy this file to .env.local for local development.
# In Vercel, add these values under Project Settings -> Environment Variables.

# Local default: uvicorn on port 8001 (see README Quick Start).
# Production: set these to your deployed backend origin / API base.

# Backend origin (no /api/v1) — used by frontend/lib/api.ts
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8001

# Backend API base URL (includes /api/v1)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8001/api/v1

# Backward-compatible alias used by some older hooks/components
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8001/api/v1

# Auth
NEXT_PUBLIC_AUTH_TOKEN_KEY=bloomcare_access_token

# Show demo autofill on login (set "false" to hide). Default: shown.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true

# Idle logout in minutes (0 = disabled; keep 0 on Vercel demos)
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=0

# App metadata
NEXT_PUBLIC_APP_NAME=BloomCare
NEXT_PUBLIC_APP_VERSION=2.0.0

# Chatbot now uses local key-answer logic (no external API key required)

# Offline service worker (Stage-1 shell). Set to false to unregister SW during demos/deploys.
# NEXT_PUBLIC_ENABLE_OFFLINE_SW=false

# AI explainability endpoint key (server-side only)
GROQ_API_KEY=your_groq_api_key_here
